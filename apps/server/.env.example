# Server
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/healthcentria?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<paste-64-hex-chars-here>
JWT_EXPIRES_IN=7d
# Email delivery (SMTP). DEFAULT_SMTP_* are the fallback; custom values saved in
# Admin > Settings are stored encrypted in the database and take priority.
# Two transports are supported; SMTP wins when host, user and pass are all set,
# otherwise Resend is used when RESEND_API_KEY is present. The old SMTP_* and
# MAIL_FROM names still work.
# Without either, emails are skipped with a console warning.
# DEFAULT_SMTP_HOST=smtp-relay.brevo.com
# DEFAULT_SMTP_PORT=587
# DEFAULT_SMTP_USER=your-smtp-login
# DEFAULT_SMTP_PASS=your-smtp-key
# DEFAULT_MAIL_FROM="E-Kalinga <clinic@your-domain.com>"
# RESEND_API_KEY=re_your_key_here
# RESEND_FROM=E-Kalinga <news@your-verified-domain.com>

# reCAPTCHA v2 ("I am not a robot" checkbox) default keys. An admin can override
# them from Admin > Settings > reCAPTCHA protection (stored encrypted in the
# database, never in this file). Old RECAPTCHA_SITE_KEY/RECAPTCHA_SECRET_KEY names still work.
# Create the key pair at https://www.google.com/recaptcha/admin — choose
# reCAPTCHA v2 → "I'm not a robot" Checkbox, and add every domain that serves
# the site: localhost and your production hostname.
# The web app gets the active site key from the API; VITE_RECAPTCHA_SITE_KEY in
# apps/web/.env is only a fallback if the API is unreachable.
# With no secret in development the check is skipped; production fails closed.
# DEFAULT_RECAPTCHA_SITE_KEY=<paste-site-key-here>
# DEFAULT_RECAPTCHA_SECRET_KEY=<paste-secret-key-here>

# Reverse-proxy hops in front of the API. Leave unset (0) locally. Set to 1 (or
# more) when deployed behind Nginx/Render/Railway so rate limiting sees the
# real client IP instead of the proxy's.
# TRUST_PROXY=1

# Google OAuth defaults (optional). Both id + secret enable the "Continue with Google" button.
# These are the DEFAULT_ fallback; an admin can override them from Admin > Settings
# (stored encrypted in the database, never in this file). Old GOOGLE_CLIENT_ID/
# GOOGLE_CLIENT_SECRET names still work.
# The callback URL must match an Authorized redirect URI in the Google Cloud console exactly.
# DEFAULT_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
# DEFAULT_GOOGLE_CLIENT_SECRET=<client-secret>
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Encrypts custom Google credentials saved from the admin UI (AES-256-GCM).
# Must be exactly 64 hex characters (32 bytes). Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SETTINGS_ENCRYPTION_KEY=<paste-64-hex-chars-here>

# Google Calendar sync (optional). Uses a service account and one dedicated
# clinic calendar. Keep that calendar private and shared only with authorized
# staff. Share it with the service account email and give it "Make changes to
# events". Leave these blank to disable the integration.
# GOOGLE_CALENDAR_ID=<calendar-id>@group.calendar.google.com
# GOOGLE_SERVICE_ACCOUNT_EMAIL=<service-account>@<project>.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_TIMEZONE=Asia/Manila
# GOOGLE_CALENDAR_LOCATION=Barangay Health Center

# Optional fallback for the seed script (CLI flags take precedence):
# SEED_EMAIL=admin@example.com
# SEED_PASSWORD=ChangeMe123
# SEED_ROLE=admin
# SEED_NAME=Clinic Admin

# Superadmin PIN and email: required to change integration credentials.
# Every save, reset to default and on/off switch in admin Settings asks for the
# PIN. SU_EMAIL receives a notice after each approved change.
SU_PIN=change-me-to-a-long-pin
SU_EMAIL=you@example.com
